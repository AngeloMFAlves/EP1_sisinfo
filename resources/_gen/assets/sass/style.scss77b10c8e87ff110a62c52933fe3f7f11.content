footer{display:grid;justify-content:center;align-items:center;text-align:center}header{display:flex;flex-direction:column;flex-wrap:wrap;align-items:center;text-align:center}header nav ul{display:flex;list-style:none;gap:1.5rem;padding:0;margin:0}@media(max-width:600px){header nav ul{flex-direction:column}}